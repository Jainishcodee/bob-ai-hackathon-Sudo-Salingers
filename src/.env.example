# Pharos environment variables. Copy to .env and edit. All are OPTIONAL — Pharos runs with none set.
# NEVER put a real key in this file — it is committed. Real values go in .env (git-ignored).

# openFDA API key. Not required. Without one you get 1,000 requests/day per IP (plenty for
# demos); with a free key from https://open.fda.gov/apis/authentication/ you get 120,000/day.
OPENFDA_API_KEY=

# Set to 1 to never touch the network and serve only from the on-disk cache.
# Run `python -m pharos build-cache` once while online first.
PHAROS_OFFLINE=0

# Where cached openFDA responses live. Default: src/pharos/faers/cache/
PHAROS_CACHE_DIR=
